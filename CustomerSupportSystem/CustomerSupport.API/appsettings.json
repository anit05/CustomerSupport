{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "CustomerSupport.API"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/customer-support-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{Application}] [TraceId: {TraceIdentifier}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CustomerSupportDBConnection": "Data Source=(local);Initial Catalog=CustomerSupportDB;User ID=sa;Password=Passw0rd@123;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "CSJwtKey_2026_7vN4pQ9xR2mK8sT5wY1cD6fH3jL0aB4eG7uP9zX2nM5qV8r",
    "Issuer": "CustomerSupport.API",
    "Audience": "CustomerSupport.Client",
    "AccessTokenMinutes": 30,
    "ClockSkewMinutes": 2,
    "RefreshTokenDays": 7
  },
  "LocalFileStorage": {
    "TicketAttachmentsPath": "Storage/TicketAttachments"
  },
  "OpenAI": {
    "Model": "gpt-5.4-mini",
    "MaxOutputTokens": 1600,
    "TimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}


