@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
    var fullName = User.Identity?.Name ?? "Account";
    var homeUrl = role switch
    {
        "Administrator" => "/admin/dashboard",
        "SupportExecutive" => "/support/dashboard",
        _ => "/customer/dashboard"
    };
    var initials = string.Concat(fullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    var roleLabel = role == "SupportExecutive" ? "Support Executive" : role;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | SupportDesk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
</head>
<body class="bg-body-tertiary">
    <div class="min-vh-100 d-flex flex-column">
        <header class="navbar navbar-dark bg-dark border-bottom border-secondary" aria-label="Primary navigation">
            <div class="container-fluid px-3 px-lg-4 py-2 d-flex align-items-center gap-3">
                @if (isAuthenticated)
                {
                    <button type="button"
                            class="btn btn-outline-light d-lg-none"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#mobileNavigation"
                            aria-controls="mobileNavigation"
                            aria-label="Open navigation">
                        <i class="bi bi-list fs-5" aria-hidden="true"></i>
                    </button>
                }

                <a class="navbar-brand d-flex align-items-center gap-3 fw-bold mb-0"
                   href="@(isAuthenticated ? homeUrl : "/login")">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary px-3 py-2">
                        <i class="bi bi-headset fs-5" aria-hidden="true"></i>
                    </span>
                    <span>Support<span class="fw-light ms-2">Desk</span></span>
                </a>

                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="btn btn-dark border border-secondary rounded-pill d-flex align-items-center gap-2"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="rounded-circle bg-primary text-white fw-bold px-2 py-1">@initials</span>
                                <span class="d-none d-sm-inline text-start small">
                                    @fullName
                                    <span class="d-block text-white-50">@roleLabel</span>
                                </span>
                                <i class="bi bi-chevron-down small text-white-50" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <a class="dropdown-item py-2" href="/account">
                                        <i class="bi bi-person-circle me-2" aria-hidden="true"></i>My account
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" action="/logout" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/login" class="btn btn-outline-light btn-sm px-3">Sign in</a>
                        <a href="/register" class="btn btn-primary btn-sm px-3">Create account</a>
                    }
                </div>
            </div>
        </header>

        @if (isAuthenticated)
        {
            <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1"
                 id="mobileNavigation" aria-labelledby="mobileNavigationLabel">
                <div class="offcanvas-header border-bottom border-secondary">
                    <h2 class="offcanvas-title h5 mb-0" id="mobileNavigationLabel">
                        <i class="bi bi-headset me-2" aria-hidden="true"></i>SupportDesk
                    </h2>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="offcanvas" aria-label="Close navigation"></button>
                </div>
                <div class="offcanvas-body">
                    @await Html.PartialAsync("_Navigation", role)
                </div>
            </div>

            <div class="container-fluid flex-grow-1 d-flex px-0">
                <div class="row flex-grow-1 g-0">
                    <aside class="col-lg-3 col-xl-2 d-none d-lg-block bg-dark text-white px-3 py-4"
                           aria-label="Workspace sidebar">
                        @await Html.PartialAsync("_Navigation", role)
                    </aside>
                    <main class="col-lg-9 col-xl-10 bg-body-tertiary p-3 p-lg-4"
                          id="main-content">
                        @await Html.PartialAsync("_Alerts")
                        @RenderBody()
                    </main>
                </div>
            </div>
        }
        else
        {
            <main class="flex-grow-1 bg-body-tertiary px-3 py-3 py-md-4" id="main-content">
                @await Html.PartialAsync("_Alerts")
                @RenderBody()
            </main>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
