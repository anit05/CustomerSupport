@model ContentListPage<KnowledgeArticle>
@{ViewData["Title"]=Model.Management?"Manage knowledge base":"Knowledge base";var path=Model.Management?"/admin/knowledge-base":"/knowledge-base";}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h1 class="h2 fw-bold mb-1">@(Model.Management?"Knowledge base management":"Knowledge base")</h1><p class="text-secondary mb-0">Search support guides and helpful articles.</p></div>
@if(Model.Management){<a class="btn btn-primary" href="/admin/knowledge-base/new"><i class="bi bi-plus-circle me-2"></i>New article</a>}</div>
<div class="card shadow-sm border-0 rounded-4 mb-4"><div class="card-body p-3 p-lg-4"><form method="get" action="@path"><div class="row g-3 align-items-end">
    <div class="col-md-6"><label class="form-label fw-semibold small" for="articleSearch">Search</label><input class="form-control" type="search" name="Search" id="articleSearch" value="@Model.Search.Search" placeholder="Search articles" /></div>
    <div class="col-md-4"><label class="form-label fw-semibold small" for="product">Product</label><select name="ProductId" class="form-select" id="product"><option value="">All products</option>@foreach(var p in Model.Products){if(p.Id==Model.Search.ProductId){<option value="@p.Id" selected>@p.Name</option>}else{<option value="@p.Id">@p.Name</option>}}</select></div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button></div>
</div></form></div></div>
<div class="row g-3">
@if(Model.Results.Items.Count==0){<div class="col-12"><div class="card border-0 shadow-sm rounded-4"><div class="card-body text-center p-5 text-secondary">No articles found.</div></div></div>}
@foreach(var a in Model.Results.Items){<div class="col-md-6"><div class="card shadow-sm border-0 rounded-4 h-100"><div class="card-body p-4 d-flex flex-column"><div class="d-flex justify-content-between gap-2 mb-3"><span class="badge text-bg-light border">@(a.ProductName??"General")</span>@if(Model.Management){<span class="badge @(a.IsPublished&&a.IsActive?"text-bg-success":"text-bg-secondary")">@(a.IsPublished&&a.IsActive?"Published":"Draft / inactive")</span>}</div><h2 class="h5 fw-bold">@a.Title</h2><p class="small text-secondary mb-4">Created @a.CreatedAt.ToString("dd MMM yyyy")</p><div class="mt-auto d-flex gap-2"><a class="btn btn-outline-primary btn-sm" href="/knowledge-base/@a.Id">Read article</a>@if(Model.Management){<a class="btn btn-primary btn-sm" href="/admin/knowledge-base/@a.Id/edit">Edit</a>}</div></div></div></div>}
</div>
@if(Model.Results.TotalPages>1){<div class="d-flex justify-content-between align-items-center mt-4"><span class="small text-secondary">Page @Model.Results.PageNumber of @Model.Results.TotalPages</span><div class="btn-group">@if(Model.Results.HasPreviousPage){<a class="btn btn-outline-primary btn-sm" href="@path?PageNumber=@(Model.Results.PageNumber-1)&amp;Search=@Uri.EscapeDataString(Model.Search.Search??"")&amp;ProductId=@Model.Search.ProductId">Previous</a>}@if(Model.Results.HasNextPage){<a class="btn btn-outline-primary btn-sm" href="@path?PageNumber=@(Model.Results.PageNumber+1)&amp;Search=@Uri.EscapeDataString(Model.Search.Search??"")&amp;ProductId=@Model.Search.ProductId">Next</a>}</div></div>}
