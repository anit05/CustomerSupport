@model KnowledgeArticle
@{ViewData["Title"]=Model.Title;}
<div class="row justify-content-center"><div class="col-xl-10"><a href="/knowledge-base" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>All articles</a>
<div class="card border-0 shadow-sm rounded-4 mt-3"><div class="card-body p-4 p-lg-5"><span class="badge text-bg-primary mb-3">@(Model.ProductName??"General article")</span><h1 class="h2 fw-bold">@Model.Title</h1><p class="text-secondary small">Published content · @Model.CreatedAt.ToString("dd MMM yyyy")</p><hr class="my-4" /><div class="text-break" >@Model.Content</div></div></div>
</div></div>
