@model RegisterForm
@{ViewData["Title"]="Create account";}
<div class="row justify-content-center"><div class="col-12 col-lg-8 col-xl-7">
    <div class="card shadow-sm border-0 rounded-4"><div class="card-body p-4 p-lg-5">
        <div class="mb-4"><span class="badge text-bg-primary mb-2">Customer registration</span><h1 class="h3 fw-bold">Create an account</h1><p class="text-secondary">Register as a customer to create and track support tickets.</p></div>
        <form action="/register" method="post">@Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FirstName" class="form-label fw-semibold">First name</label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="LastName" class="form-label fw-semibold">Last name</label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label fw-semibold">Email address</label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label fw-semibold">Phone (optional)</label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Password" class="form-label fw-semibold">Password</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm password</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
            </div>
            <button type="submit" class="btn btn-primary mt-4 px-4 py-2 fw-semibold"><i class="bi bi-person-plus me-2"></i>Create account</button>
            <a href="/login" class="btn btn-link mt-4 ms-2 text-decoration-none">Already registered?</a>
        </form>
    </div></div>
</div></div>
