@model List<Product>
@{ViewData["Title"]="Products";}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold mb-1">Products</h1><p class="text-secondary mb-0">Manage products available for customer support tickets.</p></div><a href="/admin/products/new" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add product</a></div>
<div class="card shadow-sm border-0 rounded-4"><div class="card-header bg-white p-4 d-flex justify-content-between"><span class="fw-bold">Product catalog</span><span class="small text-secondary">@Model.Count items</span></div>
@if(Model.Count==0){<div class="card-body text-center p-5 text-secondary"><i class="bi bi-box-seam fs-1"></i><p class="mt-3">No products available.</p></div>}
else{<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Product</th><th>Description</th><th>Status</th><th class="text-end pe-4">Action</th></tr></thead><tbody>
@foreach(var p in Model){<tr><td class="fw-semibold ps-4">@p.Name</td><td class="text-secondary">@p.Description</td><td><span class="badge @(p.IsActive?"text-bg-success":"text-bg-secondary")">@(p.IsActive?"Active":"Inactive")</span></td><td class="text-end pe-4"><a class="btn btn-outline-primary btn-sm" href="/admin/products/@p.Id/edit">Edit</a></td></tr>}
</tbody></table></div>}
</div>
