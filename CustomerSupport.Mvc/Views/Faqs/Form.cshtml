@model ContentForm
@{var editing=Model.Id>0; ViewData["Title"]=editing?"Edit FAQ":"New FAQ";}
<div class="row justify-content-center"><div class="col-xl-9"><a class="small text-decoration-none" href="/admin/faqs"><i class="bi bi-arrow-left me-1"></i>Back to FAQs</a><h1 class="h2 fw-bold my-3">@(editing?"Edit FAQ":"Create FAQ")</h1>
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5"><form method="post" action="/admin/faqs/save">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Title" class="form-label fw-semibold">Question</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="ProductId" class="form-label fw-semibold">Related product (optional)</label><select asp-for="ProductId" class="form-select"><option value="">General</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Name</option>}</select></div>
<div class="mb-3"><label asp-for="Content" class="form-label fw-semibold">Answer</label><textarea asp-for="Content" class="form-control" rows="8"></textarea><span asp-validation-for="Content" class="text-danger small"></span></div>
@if(editing){<div class="form-check form-switch mb-4"><input asp-for="IsActive" type="checkbox" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>}
<div class="d-flex gap-2"><button type="submit" class="btn btn-primary px-4">@(editing?"Save changes":"Create FAQ")</button><a class="btn btn-outline-secondary" href="/admin/faqs">Cancel</a></div></form>
@if(editing){<hr class="my-4"/><form method="post" action="/admin/faqs/@Model.Id/deactivate">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger" onclick="return confirm('Deactivate this FAQ?')">Deactivate FAQ</button></form>}
</div></div></div></div>
