@model ContentListPage<Faq>
@{ViewData["Title"]=Model.Management?"Manage FAQs":"Frequently asked questions";var path=Model.Management?"/admin/faqs":"/faqs";}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h1 class="h2 fw-bold mb-1">@(Model.Management?"FAQ management":"Frequently asked questions")</h1><p class="text-secondary mb-0">Answers to common questions about our products.</p></div>
@if(Model.Management){<a class="btn btn-primary" href="/admin/faqs/new"><i class="bi bi-plus-circle me-2"></i>New FAQ</a>}</div>
<div class="card shadow-sm border-0 rounded-4 mb-4"><div class="card-body p-3 p-lg-4"><form method="get" action="@path"><div class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label fw-semibold small" for="faqSearch">Search</label><input id="faqSearch" class="form-control" name="Search" value="@Model.Search.Search" placeholder="Search frequently asked questions" /></div><div class="col-md-4"><label class="form-label fw-semibold small" for="faqProduct">Product</label><select id="faqProduct" name="ProductId" class="form-select"><option value="">All products</option>@foreach(var p in Model.Products){if(Model.Search.ProductId==p.Id){<option value="@p.Id" selected>@p.Name</option>}else{<option value="@p.Id">@p.Name</option>}}</select></div><div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Search</button></div></div></form></div></div>
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
@if(Model.Results.Items.Count==0){<p class="text-secondary text-center py-4">No FAQs found.</p>}
<div class="accordion" id="faqsList">
@foreach(var f in Model.Results.Items){<div class="accordion-item mb-2 border rounded-3 overflow-hidden"><h2 class="accordion-header" id="q-@f.Id"><button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#answer-@f.Id" aria-expanded="false" aria-controls="answer-@f.Id">@f.Question</button></h2><div id="answer-@f.Id" class="accordion-collapse collapse" data-bs-parent="#faqsList"><div class="accordion-body"><p class="text-break mb-3" >@f.Answer</p><div class="d-flex align-items-center gap-2"><a href="/faqs/@f.Id" class="btn btn-outline-primary btn-sm">Open details</a>@if(Model.Management){<a href="/admin/faqs/@f.Id/edit" class="btn btn-primary btn-sm">Edit</a><span class="badge @(f.IsActive?"text-bg-success":"text-bg-secondary")">@(f.IsActive?"Active":"Inactive")</span>}</div></div></div></div>}
</div></div></div>
@if(Model.Results.TotalPages>1){<div class="d-flex justify-content-between align-items-center mt-4"><span class="small text-secondary">Page @Model.Results.PageNumber of @Model.Results.TotalPages</span><div class="btn-group">@if(Model.Results.HasPreviousPage){<a class="btn btn-outline-primary btn-sm" href="@path?PageNumber=@(Model.Results.PageNumber-1)&amp;Search=@Uri.EscapeDataString(Model.Search.Search??"")&amp;ProductId=@Model.Search.ProductId">Previous</a>}@if(Model.Results.HasNextPage){<a class="btn btn-outline-primary btn-sm" href="@path?PageNumber=@(Model.Results.PageNumber+1)&amp;Search=@Uri.EscapeDataString(Model.Search.Search??"")&amp;ProductId=@Model.Search.ProductId">Next</a>}</div></div>}
