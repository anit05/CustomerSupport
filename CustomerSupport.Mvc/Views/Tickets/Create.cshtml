@model TicketCreateForm
@{ViewData["Title"]="Create ticket";}
<div class="row justify-content-center"><div class="col-xl-9">
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold mb-1">Create support ticket</h1><p class="text-secondary mb-0">Tell us which product needs attention and describe your issue.</p></div><a href="/tickets/my" class="btn btn-outline-secondary">My tickets</a></div>
<div class="card shadow-sm border-0 rounded-4"><div class="card-body p-4 p-lg-5">
<form method="post" action="/tickets/new">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <h2 class="h5 fw-bold mb-3"><span class="text-primary me-2">01</span>Request details</h2>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="ProductId" class="form-label fw-semibold">Product</label><select asp-for="ProductId" class="form-select"><option value="0">Select product</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Name</option>}</select><span asp-validation-for="ProductId" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="CategoryId" class="form-label fw-semibold">Category (optional)</label><select asp-for="CategoryId" class="form-select"><option value="">Select category</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></div>
        <div class="col-md-6"><label asp-for="PriorityId" class="form-label fw-semibold">Priority</label><select asp-for="PriorityId" class="form-select">@foreach(var p in Model.Priorities){<option value="@p.Id">@p.Name</option>}</select><span asp-validation-for="PriorityId" class="text-danger small"></span></div>
    </div>
    <hr class="my-4" />
    <h2 class="h5 fw-bold mb-3"><span class="text-primary me-2">02</span>Describe the problem</h2>
    <div class="mb-3"><label asp-for="Subject" class="form-label fw-semibold">Subject</label><input asp-for="Subject" class="form-control" placeholder="Briefly describe the issue" /><span asp-validation-for="Subject" class="text-danger small"></span></div>
    <div class="mb-4"><label asp-for="Description" class="form-label fw-semibold">Description</label><textarea asp-for="Description" class="form-control" rows="7" placeholder="What happened? What did you expect?"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
    <div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/tickets/my">Cancel</a><button type="submit" class="btn btn-primary px-4"><i class="bi bi-send me-2"></i>Submit ticket</button></div>
</form>
</div></div></div></div>
